      "url": "{{ _.base_url }}/api/productos",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer {{ _.token }}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"nombre\": \"Laptop Gamer\",\n  \"descripcion\": \"Laptop de alto rendimiento\",\n  \"precio\": 1500.00,\n  \"cantidadStock\": 10,\n  \"categoriaId\": 1\n}"
      }
    },
    {
      "_id": "req_prod_update",
      "_type": "request",
      "parentId": "fld_productos",
      "name": "Actualizar Producto (solo ADMIN)",
      "method": "PUT",
      "url": "{{ _.base_url }}/api/productos/1",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer {{ _.token }}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"nombre\": \"Laptop Gamer Pro\",\n  \"descripcion\": \"Laptop actualizada\",\n  \"precio\": 1800.00,\n  \"cantidadStock\": 5,\n  \"categoriaId\": 1\n}"
      }
    },
    {
      "_id": "req_prod_delete",
      "_type": "request",
      "parentId": "fld_productos",
      "name": "Borrar Producto (solo ADMIN)",
      "method": "DELETE",
      "url": "{{ _.base_url }}/api/productos/1",
      "headers": [{ "name": "Authorization", "value": "Bearer {{ _.token }}" }]
    }
  ]
}

      "url": "{{ _.base_url }}/api/productos/1",
      "headers": [{ "name": "Authorization", "value": "Bearer {{ _.token }}" }]
    },
    {
      "_id": "req_prod_create",
      "_type": "request",
      "parentId": "fld_productos",

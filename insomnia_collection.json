{
  "_type": "export",
  "__export_format": 4,
  "__export_date": "2024-01-01",
  "__export_source": "insomnia",
  "resources": [
    {
      "_id": "wrk_001",
      "_type": "workspace",
      "name": "CRUD Producto y Categoria",
      "description": "Coleccion para probar los endpoints del proyecto"
    },
    {
      "_id": "env_001",
      "_type": "environment",
      "parentId": "wrk_001",
      "name": "Base Environment",
      "data": {
        "base_url": "http://localhost:8080",
        "token": ""
      }
    },
    {
      "_id": "fld_auth",
      "_type": "request_group",
      "parentId": "wrk_001",
      "name": "Auth"
    },
    {
      "_id": "req_login_admin",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Login SUPER-ADMIN-ROLE",
      "method": "POST",
      "url": "{{ _.base_url }}/api/auth/login",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
      }
    },
    {
      "_id": "req_login_user",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Login USER",
      "method": "POST",
      "url": "{{ _.base_url }}/api/auth/login",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"username\": \"usuario\",\n  \"password\": \"user123\"\n}"
      }
    },
    {
      "_id": "fld_categorias",
      "_type": "request_group",
      "parentId": "wrk_001",
      "name": "Categorias"
    },
    {
      "_id": "req_cat_list",
      "_type": "request",
      "parentId": "fld_categorias",
      "name": "Listar Categorias",
      "method": "GET",
      "url": "{{ _.base_url }}/api/categorias",
      "headers": [{ "name": "Authorization", "value": "Bearer {{ _.token }}" }]
    },
    {
      "_id": "req_cat_get",
      "_type": "request",
      "parentId": "fld_categorias",
      "name": "Obtener Categoria por ID",

      "url": "{{ _.base_url }}/api/categorias",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer {{ _.token }}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"nombre\": \"Electronica\",\n  \"descripcion\": \"Productos electronicos y tecnologia\"\n}"
      }
    },
    {
      "_id": "req_cat_update",
      "_type": "request",
      "parentId": "fld_categorias",
      "name": "Actualizar Categoria (solo ADMIN)",
      "method": "PUT",
      "url": "{{ _.base_url }}/api/categorias/1",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer {{ _.token }}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"nombre\": \"Electronica Actualizada\",\n  \"descripcion\": \"Descripcion actualizada\"\n}"
      }
    },
    {
      "_id": "req_cat_delete",
      "_type": "request",
      "parentId": "fld_categorias",
      "name": "Borrar Categoria (solo ADMIN)",
      "method": "DELETE",
      "url": "{{ _.base_url }}/api/categorias/1",
      "headers": [{ "name": "Authorization", "value": "Bearer {{ _.token }}" }]
    },
    {
      "_id": "fld_productos",
